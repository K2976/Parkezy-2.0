# =====================================================================================
#  Parkezy backend configuration
#  Copy to .env and fill in. Every external service below has a FREE tier that is
#  enough for development and an early launch. Nothing here is hard-coded in the app.
#
#  Business rules (GST, commission, overstay fee, booking limits, search radius…) are
#  NOT env vars: they live in the `platform_settings` table and are changed at runtime
#  through PATCH /v1/admin/settings.
# =====================================================================================

# ------------------------------------------------------------------ App
# local | test | staging | production
APP_ENV=local
APP_NAME=Parkezy
API_PUBLIC_URL=http://localhost:8000
# Links inside emails open the app with this base (Expo scheme in dev: exp://<lan-ip>:8081/--/)
APP_DEEP_LINK_BASE=parkezy://
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Comma-separated emails that are made admins when they register
ADMIN_EMAILS=
DEFAULT_TIMEZONE=Asia/Kolkata
# true only when running behind a proxy/load balancer you control (Render, Fly, nginx)
TRUST_FORWARDED_FOR=false

# ------------------------------------------------------------------ PostgreSQL + PostGIS
# Local: docker compose (port 5434).
# Free hosted: Neon (https://neon.tech, 0.5 GB, PostGIS supported, scales to zero but
# never hibernates permanently).  Paste the "pooled" connection string as-is: the
# postgresql:// scheme, sslmode= and channel_binding= are converted for asyncpg automatically,
# and migrations go to the direct (non -pooler) endpoint on their own.
DATABASE_URL=postgresql+asyncpg://parkezy:parkezy@localhost:5434/parkezy
# Optional read replica for search/listing pages (ch. 16: read-heavy, slight lag is fine). Empty = use primary.
DATABASE_READ_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false
DB_POOL_RECYCLE_SECONDS=300
# Transaction-mode PgBouncer needs prepared-statement caching off. Empty = auto (host contains "-pooler.")
DB_PGBOUNCER=
# Client-side per-statement timeout (works through PgBouncer, unlike server statement_timeout)
DB_COMMAND_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------ Redis (cache, rate limit, bloom filters, Celery)
# Local: docker compose (port 6380).
# Free hosted: Redis Cloud Essentials free (https://redis.io/try-free, 30 MB, no
# per-command quota - better for Celery than Upstash's command-metered free tier).
REDIS_URL=redis://localhost:6380/0
# Bounded so a hung Redis fails fast (rate limiter/cache then fail open) instead of stalling requests
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_SECONDS=30
# Per process. Redis Cloud free allows 30 clients across ALL api workers + celery worker + beat.
REDIS_MAX_CONNECTIONS=10
CELERY_BROKER_POOL_LIMIT=4
# Optional separate broker for Celery; defaults to REDIS_URL
CELERY_BROKER_URL=
OUTBOX_SWEEP_SECONDS=30
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_SECONDS=15
OUTBOX_BACKOFF_MAX_SECONDS=3600
# Expire unpaid holds / unanswered requests / no-shows and send "ending soon" reminders
MAINTENANCE_SWEEP_SECONDS=60
# Purge expired tokens, used codes and abandoned uploads
CLEANUP_INTERVAL_HOURS=24
STALE_UPLOAD_HOURS=24

# ------------------------------------------------------------------ Auth (self-issued JWT)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=parkezy-api
JWT_AUDIENCE=parkezy-app
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_LENGTH=6

# ------------------------------------------------------------------ Parking access (PIN + signed QR)
# Separate secret from JWT_SECRET. Rotating it invalidates every outstanding PIN/QR.
ACCESS_CODE_SECRET=change-me-generate-another-long-random-string
ACCESS_PIN_LENGTH=6
QR_TOKEN_TTL_SECONDS=120

# ------------------------------------------------------------------ Rate limits (per IP / user, per window)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_PER_WINDOW=10
RATE_LIMIT_ACCESS_VERIFY_PER_WINDOW=20
RATE_LIMIT_DEFAULT_PER_WINDOW=120

# ------------------------------------------------------------------ Cache / bloom filters
SEARCH_CACHE_TTL_SECONDS=30
# Proximity search caches per geohash cell (shared by nearby users) and re-filters exactly per request
SEARCH_CELL_ERROR_RATIO=0.25
SEARCH_CANDIDATE_MULTIPLIER=3
# platform_settings cache; admin edits invalidate it immediately anyway
RULES_CACHE_TTL_SECONDS=60
BLOOM_CAPACITY=1000000
BLOOM_ERROR_RATE=0.001

# ------------------------------------------------------------------ Email
# console = print to logs | smtp = Mailpit locally (UI http://localhost:8025) | resend = production
EMAIL_PROVIDER=smtp
EMAIL_FROM=Parkezy <no-reply@mail.parkezy.com>
EMAIL_REPLY_TO=support@parkezy.com
# Resend free tier: 3,000 emails/month, 100/day. https://resend.com
# Verify a sending subdomain (e.g. mail.parkezy.com) and add the SPF/DKIM/DMARC records.
RESEND_API_KEY=
# Webhooks -> https://<api>/v1/webhooks/resend (signing secret starts with whsec_)
RESEND_WEBHOOK_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# ------------------------------------------------------------------ Object storage (Backblaze B2, S3-compatible)
# Free tier: 10 GB storage, egress free up to 3x stored data. https://www.backblaze.com/cloud-storage
# Create a PRIVATE bucket + an application key restricted to that bucket.
# Endpoint looks like https://s3.<region>.backblazeb2.com  (region e.g. us-west-004)
# Bucket CORS must allow PUT from the app (see backend/README.md).
# Local: SeaweedFS from docker compose.
S3_ENDPOINT_URL=http://localhost:8333
# URL the PHONE uses for presigned uploads/downloads if it differs (e.g. http://192.168.1.10:8333)
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=parkezy-local
S3_SECRET_ACCESS_KEY=parkezy-local-secret
S3_BUCKET=parkezy-media
# Optional public CDN base (e.g. Cloudflare in front of B2). Empty = presigned GET URLs.
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL_SECONDS=900
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/heic,image/webp

# ------------------------------------------------------------------ Payments
# offline  = driver pays at the venue (no gateway, works with zero keys)
# razorpay = online payments. Test mode is free: https://dashboard.razorpay.com (Test Mode)
PAYMENT_PROVIDER=offline
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> https://<api>/v1/webhooks/razorpay, events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Reconciliation: ask Razorpay about orders still unpaid after N minutes (lost webhooks, closed apps)
PAYMENT_RECONCILE_INTERVAL_SECONDS=300
PAYMENT_RECONCILE_AFTER_MINUTES=5
PAYMENT_ABANDON_AFTER_MINUTES=60
PAYMENT_RECONCILE_BATCH=100

# ------------------------------------------------------------------ Push notifications
# expo = Expo Push Service (free, wraps APNs + FCM). none = in-app notifications only.
PUSH_PROVIDER=expo
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Optional: only needed if you enable "enhanced push security" in your Expo account
EXPO_ACCESS_TOKEN=

# ------------------------------------------------------------------ Outbound HTTP
HTTP_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------ Observability
# Sentry free tier: 5k errors/month. https://sentry.io  (empty = disabled)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Prometheus scrape endpoint GET /metrics (Grafana Cloud free tier can scrape it). Empty = disabled.
METRICS_TOKEN=

# ------------------------------------------------------------------ Not used yet (reserved)
# Qdrant vector DB - free 1 GB cluster at https://cloud.qdrant.io. Only needed if we add
# semantic search / recommendations; v1 search is PostGIS + filters, so it stays off.
# QDRANT_URL=
# QDRANT_API_KEY=
