# =====================================================================
#  Parkezy mobile (Expo) configuration. Copy to .env.
#  EXPO_PUBLIC_* values are bundled into the app (never put secrets in them).
# =====================================================================

# Backend base URL. On a phone, use your computer's LAN IP, not localhost
# (e.g. http://192.168.1.10:8000). Android emulator: http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Request timeout for API calls (ms)
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Initial map region when location permission is denied (city centre)
EXPO_PUBLIC_DEFAULT_LATITUDE=12.9716
EXPO_PUBLIC_DEFAULT_LONGITUDE=77.5946

# Support contact shown in the app
EXPO_PUBLIC_SUPPORT_EMAIL=support@parkezy.com
EXPO_PUBLIC_PRIVACY_URL=https://parkezy.com/privacy
EXPO_PUBLIC_TERMS_URL=https://parkezy.com/terms

# OpenStreetMap tile server.
# Note: tile.openstreetmap.org blocks native Android Dalvik/OkHttp user-agents with
# HTTP 403 / "Access denied". Using tile.openstreetmap.de (or CartoDB) provides full
# compatibility across both native Android and Web.
EXPO_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png

# ---- Build-time only (read by app.config.ts, not bundled) ----
APP_DISPLAY_NAME=Parkezy
APP_SCHEME=parkezy
IOS_BUNDLE_ID=com.parkezy.app
ANDROID_PACKAGE=com.parkezy.app

# Google Maps SDK for Android key (free, no usage cost for mobile SDK maps).
# Google Cloud console -> enable "Maps SDK for Android" -> API key restricted to the
# Android package + SHA-1. Not needed for Expo Go or iOS (Apple Maps).
GOOGLE_MAPS_ANDROID_API_KEY=

# EAS project id (free Expo account): `npx eas-cli@latest init` prints it.
# Needed for push notifications in development/production builds.
EAS_PROJECT_ID=

# Clerk Authentication Publishable Key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
