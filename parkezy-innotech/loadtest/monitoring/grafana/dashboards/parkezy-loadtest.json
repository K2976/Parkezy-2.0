     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(parkezy_http_requests_total{status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(parkezy_http_requests_total[$__rate_interval])),1e-9)",
