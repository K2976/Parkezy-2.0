{
 "uid": "parkezy-loadtest",
 "title": "Parkezy load test",
 "tags": [
  "parkezy",
  "k6",
  "loadtest"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "testid",
    "label": "k6 run",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(k6_vus, testid)",
     "refId": "q"
    },
    "definition": "label_values(k6_vus, testid)",
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 2
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Overview",
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "type": "stat",
   "title": "API requests / s",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(parkezy_http_requests_total[$__rate_interval]))",
     "refId": "A",
     "instant": false
    }
   ]
  },
  {
   "type": "stat",
